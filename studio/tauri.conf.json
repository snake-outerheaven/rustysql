{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rustysql studio",
  "version": "0.1.0",
  "identifier": "dev.rustysql.studio",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "rustysql studio", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
